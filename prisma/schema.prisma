generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DOCTOR
  RECEPTIONIST
  ANCILLARY_STAFFS
  ADMIN
}

enum TransType {
  APPOINTMENT_PAYMENT // 11
  APPOINTMENT_REFUND // 19

  BOOKING_PAYMENT_1 // 21
  BOOKING_PAYMENT_2 // 22
  BOOKING_REFUND // 29

  ORDER_PAYMENT // 31
  ORDER_REFUND // 39

  WALLET_TOPUP // 41
  WALLET_WITHDRAW // 42
}

enum TransStatus {
  SUCCESSED
  CANCELLED
  PENDING
}

// 11 - thanh toán cho appointment
// 19 - hoàn tiền cho appointment
// 21 - thanh toán cho booking lần 1
// 22 - thanh toán cho booking lần 2
// 29 - hoàn tiền cho booking
// 31 - thanh toán cho order
// 39 - hoàn tiền cho order
// 41 - nạp tiền cho wallet
// 42 - rút tiền cho wallet

enum Gender {
  MALE
  FEMALE
}

enum ShiftStatus {
  AVAILABLE
  FULL
  CLOSED
}

model Users {
  id         String    @id @default(uuid()) @db.Uuid
  full_name  String
  email      String    @unique
  dob        DateTime? @db.Timestamptz()
  role       UserRole  @default(USER)
  gender     Gender    @default(MALE)
  citizen_id String?   @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz()
  doctors    Doctors[]
  bookings   Booking[]

  @@index([full_name])
  @@index([role, gender])
  @@map("users")
}

model Transaction {
  id        String      @id @default(uuid()) @db.Uuid
  amount    Int
  transDate DateTime    @default(now()) @db.Timestamptz()
  transType TransType
  docNo     Int         @unique
  buyerId   String      @db.Uuid
  status    TransStatus @default(PENDING)

  @@index([docNo, status])
  @@index([transDate, transType])
  @@index([buyerId])
  @@map("transaction")
}

model Specialty {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  doctors Doctors[]

  @@index([name])
  @@map("specialty")
}

model Doctors {
  id                        String @id @db.Uuid
  specialtyId               Int
  practiceCertificateNumber String @unique

  doctor      Users     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shifts    Shift[]

  @@index([practiceCertificateNumber, specialtyId])
  @@map("doctors")
}

model Shift {
  id        String      @id @default(uuid()) @db.Uuid
  doctorId  String      @db.Uuid
  date      DateTime    @default(now()) @db.Timestamptz()
  startTime String
  endTime   String
  capacity  Int         @default(10)
  status    ShiftStatus @default(AVAILABLE)

  doctors Doctors @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  bookings Booking[]

  @@unique([doctorId, date, startTime, endTime])
  @@index([doctorId, startTime])
  @@map("shift")
}

model Booking {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  shiftId String @db.Uuid

  patient Users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, shiftId])
  @@index([userId])
  @@index([shiftId])
  @@map("booking")
}

model Step {
  id          String @id @default(uuid()) @db.Uuid
  flowId      String @db.Uuid
  number      Int   
  name        String
  description String

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([flowId, number])
  @@map("step")
}

model Flow {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  userId String @db.Uuid
  steps  Step[]

  @@index([name])
  @@index([userId])
  @@map("flow")
}
