generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DOCTOR
  RECEPTIONIST
  ANCILLARY_STAFFS
  ADMIN
}

enum TransType {
  APPOINTMENT_PAYMENT // 11
  APPOINTMENT_REFUND // 19

  BOOKING_PAYMENT_1 // 21
  BOOKING_PAYMENT_2 // 22
  BOOKING_REFUND // 29

  ORDER_PAYMENT // 31
  ORDER_REFUND // 39

  WALLET_TOPUP // 41
  WALLET_WITHDRAW // 42
}

enum TransStatus {
  SUCCESSED
  CANCELLED
  PENDING
}

// 11 - thanh toán cho appointment
// 19 - hoàn tiền cho appointment
// 21 - thanh toán cho booking lần 1
// 22 - thanh toán cho booking lần 2
// 29 - hoàn tiền cho booking
// 31 - thanh toán cho order
// 39 - hoàn tiền cho order
// 41 - nạp tiền cho wallet
// 42 - rút tiền cho wallet

enum Gender {
  MALE
  FEMALE
}

model Users {
  id         String    @id @default(uuid()) @db.Uuid
  full_name  String
  email      String    @unique
  dob        DateTime? @db.Timestamptz()
  role       UserRole  @default(USER)
  gender     Gender    @default(MALE)
  citizen_id String?   @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz()

  @@index([full_name])
  @@index([role, gender])
  @@map("users")
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid
  amount Int 
  transDate DateTime @default(now()) @db.Timestamptz()
  transType TransType 
  docNo Int @unique
  buyerId String @db.Uuid
  status TransStatus @default(PENDING)
  @@index([docNo, status])
  @@index([transDate, transType])
  @@index([buyerId])
  @@map("transaction")
}
